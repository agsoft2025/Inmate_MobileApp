{
  "expo": {
    "name": "Inmate Management",
    "slug": "inmatemobileapp",
    "icon": "./assets/images/icon.png",
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 28
          },
          "ios": {
            "deploymentTarget": "16.0"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "android": {
      "package": "com.agummi.inmate_management_mobile_app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.INTERNET"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.agummi.inmatemanagementmobileapp",
      "buildNumber": "2",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": [
          "razorpay",
          "upi",
          "phonepe",
          "paytmmp",
          "gpay"
        ],
        "NSPhotoLibraryUsageDescription": "This app needs access to your photo library to upload student images.",
        "NSCameraUsageDescription": "This app uses the camera to capture student photos."
      }
    },
    "runtimeVersion": "1.0.0",
    "extra": {
      "eas": {
        "projectId": "a023998c-e61b-46df-9c7e-ab9e6284e9bd"
      },
      "globalurl": "https://p650f05f-4001.inc1.devtunnels.ms/",
      "razorpayKeyId": "rzp_live_Rt5vLcnxGaTs8Y"
    }
  }
}
