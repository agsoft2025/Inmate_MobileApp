{
  "expo": {
    "name": "inmate_mobile_app",
    "slug": "inmatemobileapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "inmatemobileapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,

    "ios": {
      "supportsTablet": true
    },

    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.agummi.inmatemobileapp",
      "usesCleartextTraffic": true,
      "networkSecurityConfig": "./network_security_config.xml"
    },

    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },

    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-secure-store"
    ],

    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },

    "extra": {
      "projectId": "your-project-id",
      "apiUrl": "https://inmate-project.onrender.com/",
      "globalurl": "https://nvl2rk2s-4001.inc1.devtunnels.ms/",
      // "globalurl": "https://inmateglobalserver-be.onrender.com/",
      "router": {},
      "eas": {
        "projectId": "a023998c-e61b-46df-9c7e-ab9e6284e9bd"
      }
    }
  }
}
